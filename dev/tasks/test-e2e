set -o errexit
set -o nounset
set -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

CLUSTER_NAME="auto-optimizer"
KIND_VERSION="v0.31.0"
CLEANUP_ONLY="false"
DELETE_EXISTING="false"

for arg in "$@"; do
  case "${arg}" in
    --cleanup|-c)
      CLEANUP_ONLY="true"
      ;;
    --delete|-d)
      DELETE_EXISTING="true"
      ;;
    -h|--help)
      echo "Usage: $0 [--cleanup|-c] [--delete|-d]"
      echo ""
      echo "Options:"
      echo "  --cleanup, -c  Delete the kind cluster '${CLUSTER_NAME}' and exit"
      echo "  --delete, -d   Delete any existing kind cluster '${CLUSTER_NAME}' before creating a fresh one"
      exit 0
      ;;
    *)
      echo "Unknown argument: ${arg}" >&2
      echo "Usage: $0 [--cleanup|-c] [--delete|-d]" >&2
      exit 1
      ;;
  esac
done

if [[ "${CLEANUP_ONLY}" == "true" ]]; then
  if [[ -x "${REPO_ROOT}/.build/src/kind/${KIND_VERSION}/bin/kind" && ! -x "${REPO_ROOT}/.build/bin/kind" ]]; then
    mkdir -p "${REPO_ROOT}/.build/bin"
    ln -sf "../src/kind/${KIND_VERSION}/bin/kind" "${REPO_ROOT}/.build/bin/kind"
  fi
  if [[ -d "${REPO_ROOT}/.build/bin" ]]; then
    export PATH="${REPO_ROOT}/.build/bin:${PATH}"
  fi
  if command -v kind >/dev/null 2>&1; then
    echo "Deleting kind cluster ${CLUSTER_NAME} if present..."
    kind delete cluster --name "${CLUSTER_NAME}"
  else
    echo "kind is not installed; cluster ${CLUSTER_NAME} does not exist."
  fi
  exit 0
fi

# ------------------------------------------------------------------------------
# 1. Tool Installation (pinned kind and kubectl into .build/bin)
# ------------------------------------------------------------------------------
KIND_BIN="${REPO_ROOT}/.build/src/kind/${KIND_VERSION}/bin/kind"
if [[ ! -x "${KIND_BIN}" ]]; then
  echo "Installing kind ${KIND_VERSION}..."
  mkdir -p "$(dirname "${KIND_BIN}")"
  GOBIN="$(dirname "${KIND_BIN}")" GOTOOLCHAIN=auto go install "sigs.k8s.io/kind@${KIND_VERSION}"
fi
mkdir -p "${REPO_ROOT}/.build/bin"
ln -sf "../src/kind/${KIND_VERSION}/bin/kind" "${REPO_ROOT}/.build/bin/kind"

KUBECTL_VERSION="v1.35.0"
KUBECTL_BIN="${REPO_ROOT}/.build/src/kubectl/${KUBECTL_VERSION}/bin/kubectl"
if [[ ! -x "${KUBECTL_BIN}" ]]; then
  echo "Installing kubectl ${KUBECTL_VERSION}..."
  mkdir -p "$(dirname "${KUBECTL_BIN}")"
  curl -sLo "${KUBECTL_BIN}" "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/$(go env GOOS)/$(go env GOARCH)/kubectl"
  chmod +x "${KUBECTL_BIN}"
fi
ln -sf "../src/kubectl/${KUBECTL_VERSION}/bin/kubectl" "${REPO_ROOT}/.build/bin/kubectl"

# Note: ap builds container images by invoking 'docker buildx build' under the hood
# (see gke-labs-infra/ap/pkg/images/build.go). When running in minimal environments
# (such as container agents with a remote DOCKER_HOST daemon), the docker CLI and
# docker-buildx plugin must be available on PATH / in cli-plugins.
if ! command -v docker >/dev/null 2>&1; then
  DOCKER_VERSION="29.2.1"
  DOCKER_BIN="${REPO_ROOT}/.build/src/docker/${DOCKER_VERSION}/bin/docker"
  if [[ ! -x "${DOCKER_BIN}" ]]; then
    echo "Installing docker ${DOCKER_VERSION}..."
    mkdir -p "$(dirname "${DOCKER_BIN}")"
    curl -sLo "${REPO_ROOT}/.build/src/docker/${DOCKER_VERSION}/docker.tgz" "https://download.docker.com/linux/static/stable/x86_64/docker-${DOCKER_VERSION}.tgz"
    tar -C "$(dirname "${DOCKER_BIN}")" -xzf "${REPO_ROOT}/.build/src/docker/${DOCKER_VERSION}/docker.tgz" --strip-components=1 docker/docker
    rm "${REPO_ROOT}/.build/src/docker/${DOCKER_VERSION}/docker.tgz"
    chmod +x "${DOCKER_BIN}"
  fi
  ln -sf "../src/docker/${DOCKER_VERSION}/bin/docker" "${REPO_ROOT}/.build/bin/docker"
fi

# Ensure docker-buildx plugin is installed if missing
if command -v docker >/dev/null 2>&1 || [[ -x "${REPO_ROOT}/.build/bin/docker" ]]; then
  export PATH="${REPO_ROOT}/.build/bin:${PATH}"
  if ! docker buildx version >/dev/null 2>&1; then
    BUILDX_VERSION="v0.21.1"
    BUILDX_OS="$(go env GOOS)"
    BUILDX_ARCH="$(go env GOARCH)"
    BUILDX_BIN="${REPO_ROOT}/.build/src/docker-buildx/${BUILDX_VERSION}/bin/docker-buildx"
    if [[ ! -x "${BUILDX_BIN}" ]]; then
      echo "Installing docker-buildx ${BUILDX_VERSION} for ${BUILDX_OS}/${BUILDX_ARCH}..."
      mkdir -p "$(dirname "${BUILDX_BIN}")"
      curl -sLo "${BUILDX_BIN}" "https://github.com/docker/buildx/releases/download/${BUILDX_VERSION}/buildx-${BUILDX_VERSION}.${BUILDX_OS}-${BUILDX_ARCH}"
      chmod +x "${BUILDX_BIN}"
    fi
    mkdir -p "${REPO_ROOT}/.build/bin" "${HOME}/.docker/cli-plugins"
    ln -sf "../src/docker-buildx/${BUILDX_VERSION}/bin/docker-buildx" "${REPO_ROOT}/.build/bin/docker-buildx"
    ln -sf "${REPO_ROOT}/.build/bin/docker-buildx" "${HOME}/.docker/cli-plugins/docker-buildx"
  fi
fi

export PATH="${REPO_ROOT}/.build/bin:${PATH}"
echo "Pinned tools (kind, kubectl, docker) ready in ${REPO_ROOT}/.build/bin"

# ------------------------------------------------------------------------------
# 2. Kind Cluster Management
# ------------------------------------------------------------------------------
if [[ "${DELETE_EXISTING}" == "true" ]]; then
  echo "Deleting existing cluster ${CLUSTER_NAME} if present..."
  kind delete cluster --name "${CLUSTER_NAME}" >/dev/null 2>&1 || true
fi

EXISTING_CLUSTERS="$(kind get clusters 2>/dev/null || true)"
if echo "${EXISTING_CLUSTERS}" | grep -qx "${CLUSTER_NAME}"; then
  echo "Reusing existing kind cluster: ${CLUSTER_NAME}"
  kubectl config use-context "kind-${CLUSTER_NAME}"
else
  echo "Creating kind cluster: ${CLUSTER_NAME}..."
  kind create cluster --name "${CLUSTER_NAME}"
fi

# Set image parameters for kind
export IMAGE_PREFIX="${IMAGE_PREFIX:-auto-optimizer.local}"
export IMAGE_TAG="${IMAGE_TAG:-dev}"

# ------------------------------------------------------------------------------
# 3. Deploy Dependencies to Cluster
# ------------------------------------------------------------------------------
echo "=== Running dev/tasks/deploy-to-kube ==="
"${REPO_ROOT}/dev/tasks/deploy-to-kube"

echo "=== Kind cluster ${CLUSTER_NAME} prepared and ready for E2E tests ==="
