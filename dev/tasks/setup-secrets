set -o errexit
set -o nounset
set -o pipefail

die() { echo "ERROR: $*" >&2; exit 1; }

usage() {
  cat << EOF
Usage: $0 [--only <secret>]

Create or update auto-optimizer Secrets in Kubernetes.

Options:
  --only <secret>  Configure only the specified secret(s) (comma-separated or repeatable).
                   Available secrets: forge, web-auth, model-keys
  -h, --help       Show this help text

Environment variables:
  AO_NAMESPACE             Target namespace (default: ao-system)
  GITHUB_TOKEN             GitHub token for ao-forge
  AO_GITHUB_CLIENT_ID      GitHub OAuth client ID for ao-web-auth
  AO_GITHUB_CLIENT_SECRET  GitHub OAuth client secret for ao-web-auth
  AO_SESSION_KEY           Session key for ao-web-auth (preserved or auto-generated if unset)
  GEMINI_API_KEY           Gemini API key for ao-model-keys
  OPENAI_API_KEY           OpenAI-compatible API key for ao-model-keys
  OPENAI_BASE_URL          Optional OpenAI-compatible base URL for ao-model-keys
EOF
}

CLI_TARGETS=""
ONLY_SET="false"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --only)
      [[ $# -ge 2 ]] || die "--only requires a secret argument"
      ONLY_SET="true"; CLI_TARGETS="${CLI_TARGETS:+${CLI_TARGETS},}$2"; shift 2 ;;
    --only=*)
      ONLY_SET="true"; CLI_TARGETS="${CLI_TARGETS:+${CLI_TARGETS},}${1#*=}"; shift ;;
    -h|--help)
      usage; exit 0 ;;
    *)
      die "Unknown argument: $1 (usage: $0 [--only <secret>])" ;;
  esac
done

TARGETS="forge,web-auth,model-keys"
if [[ "${ONLY_SET}" == "true" ]]; then
  TARGETS="${CLI_TARGETS}"
fi

CLEAN_TARGETS=""
IFS=',' read -ra RAW_TARGETS <<< "${TARGETS}"
for target in "${RAW_TARGETS[@]}"; do
  target="$(printf '%s' "${target}" | tr -d '[:space:]')"
  [[ -z "${target}" ]] && continue
  case "${target}" in
    forge|web-auth|model-keys) ;;
    *) die "Unknown secret '${target}'. Valid secrets are: forge, web-auth, model-keys" ;;
  esac
  [[ ",${CLEAN_TARGETS}," == *",${target},"* ]] && continue
  CLEAN_TARGETS="${CLEAN_TARGETS:+${CLEAN_TARGETS},}${target}"
done
TARGETS="${CLEAN_TARGETS}"
[[ -n "${TARGETS}" ]] || die "No valid secrets specified. Valid secrets are: forge, web-auth, model-keys"

has_target() { [[ ",${TARGETS}," == *",$1,"* ]]; }

prompt_var() {
  local _pv_mode="$1" _pv_var="$2" _pv_prompt="$3" _pv_val="${!2:-}"
  [[ -n "${_pv_val}" ]] && return 0
  printf '%s: ' "${_pv_prompt}" >&2
  if [[ "${_pv_mode}" == "secret" ]]; then
    IFS= read -r -s _pv_val || true
    echo "" >&2
  else
    IFS= read -r _pv_val || true
  fi
  printf -v "${_pv_var}" '%s' "${_pv_val}"
}

apply_secret() {
  local name="$1"
  shift
  kubectl create secret generic "${name}" -n "${AO_NAMESPACE}" "$@" --dry-run=client -o yaml | kubectl apply -f -
}

setup_forge() {
  echo "--- Configuring secret ao-forge ---"
  local token="${GITHUB_TOKEN:-}"
  prompt_var secret token "GITHUB_TOKEN"
  [[ -n "${token}" ]] || die "GITHUB_TOKEN is required for ao-forge."
  apply_secret ao-forge --from-literal="GITHUB_TOKEN=${token}"
}

setup_web_auth() {
  echo "--- Configuring secret ao-web-auth ---"
  local client_id="${AO_GITHUB_CLIENT_ID:-}"
  local client_secret="${AO_GITHUB_CLIENT_SECRET:-}"
  local session_key="${AO_SESSION_KEY:-}"

  prompt_var plain client_id "AO_GITHUB_CLIENT_ID"
  [[ -n "${client_id}" ]] || die "AO_GITHUB_CLIENT_ID is required for ao-web-auth."
  prompt_var secret client_secret "AO_GITHUB_CLIENT_SECRET"
  [[ -n "${client_secret}" ]] || die "AO_GITHUB_CLIENT_SECRET is required for ao-web-auth."

  if [[ -z "${session_key}" ]]; then
    local existing_b64
    existing_b64="$(kubectl get secret ao-web-auth -n "${AO_NAMESPACE}" -o jsonpath='{.data.AO_SESSION_KEY}' 2>/dev/null || true)"
    if [[ -n "${existing_b64}" ]]; then
      session_key="$(printf '%s' "${existing_b64}" | base64 -d 2>/dev/null || true)"
    fi
    if [[ -n "${session_key}" ]]; then
      echo "Preserving existing AO_SESSION_KEY from ao-web-auth."
    else
      command -v openssl >/dev/null 2>&1 || die "openssl is required to generate AO_SESSION_KEY (or set AO_SESSION_KEY)."
      session_key="$(openssl rand -hex 32)"
      echo "Generated new AO_SESSION_KEY."
    fi
  fi

  apply_secret ao-web-auth --from-literal="AO_GITHUB_CLIENT_ID=${client_id}" --from-literal="AO_GITHUB_CLIENT_SECRET=${client_secret}" --from-literal="AO_SESSION_KEY=${session_key}"
}

setup_model_keys() {
  echo "--- Configuring secret ao-model-keys (optional) ---"
  local gemini_key="${GEMINI_API_KEY:-}"
  local openai_key="${OPENAI_API_KEY:-}"
  local openai_base_url="${OPENAI_BASE_URL:-}"

  if [[ -z "${gemini_key}" && -z "${openai_key}" ]]; then
    prompt_var secret gemini_key "GEMINI_API_KEY (leave blank to use OpenAI or Vertex AI Workload Identity)"
    if [[ -z "${gemini_key}" ]]; then
      prompt_var secret openai_key "OPENAI_API_KEY (leave blank to skip when using Vertex AI Workload Identity)"
      if [[ -n "${openai_key}" ]]; then
        prompt_var plain openai_base_url "OPENAI_BASE_URL (optional, leave blank for default)"
      fi
    fi
  fi

  if [[ -z "${gemini_key}" && -z "${openai_key}" ]]; then
    echo "Skipping ao-model-keys (no API key provided)."
    return 0
  fi

  local args=()
  [[ -n "${gemini_key}" ]] && args+=(--from-literal="GEMINI_API_KEY=${gemini_key}")
  [[ -n "${openai_key}" ]] && args+=(--from-literal="OPENAI_API_KEY=${openai_key}")
  [[ -n "${openai_base_url}" ]] && args+=(--from-literal="OPENAI_BASE_URL=${openai_base_url}")
  apply_secret ao-model-keys "${args[@]}"
}

command -v kubectl >/dev/null 2>&1 || die "kubectl is required."

AO_NAMESPACE="${AO_NAMESPACE:-ao-system}"
CURRENT_CONTEXT="$(kubectl config current-context 2>/dev/null || echo "unknown")"

echo "=== Configuring auto-optimizer secrets in namespace '${AO_NAMESPACE}' (context: ${CURRENT_CONTEXT}) ==="
echo "Secrets: ${TARGETS}"

kubectl create namespace "${AO_NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -

if has_target "forge"; then setup_forge; fi
if has_target "web-auth"; then setup_web_auth; fi
if has_target "model-keys"; then setup_model_keys; fi

echo "=== setup-secrets completed successfully ==="
